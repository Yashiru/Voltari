; Engine configuration file.
; See CLAUDE.md and docs/architecture/layers.md before editing.

config_version=5

[application]

config/name="Voltari"
config/features=PackedStringArray("4.7", "Mobile")

[debug]

; Static typing is mandatory (CLAUDE.md). These promote the relevant GDScript
; warnings to errors so the compiler enforces it rather than review alone.
; 0 = ignore, 1 = warning, 2 = error.
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/shadowed_variable=2
gdscript/warnings/inferred_declaration=1
gdscript/warnings/return_value_discarded=1

[rendering]

; Mobile (Vulkan) everywhere by default; Compatibility is an export fallback for
; old devices and web, configured per export preset rather than globally.
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
